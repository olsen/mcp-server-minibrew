# Your MiniBrew login: the server logs in itself and renews its token (see README).
# Quote the password if it contains spaces or #. Keep this file private: chmod 600 .env
MINIBREW_EMAIL=
MINIBREW_PASSWORD=

# Or/also: a bearer token copied from a logged-in pro.minibrew.io session. Used when no
# login is set or the login fails. Tokens expire; paste a fresh one and no restart is needed.
MINIBREW_TOKEN=
